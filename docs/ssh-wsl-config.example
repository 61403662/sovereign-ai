# Copy to ~/.ssh/config on WSL. chmod 600 ~/.ssh/config
# Replace HostName (Deploy LAN IP or hostname) and User (Windows login).

Host deploy
  HostName 192.168.1.100
  User YourWindowsUser
  IdentitiesOnly yes
  # IdentityFile ~/.ssh/id_ed25519

# GitHub (if not using default ~/.ssh/id_ed25519):
# Host github.com
#   HostName github.com
#   User git
#   IdentityFile ~/.ssh/id_ed25519_github